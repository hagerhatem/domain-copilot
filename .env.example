# Copy this file to `.env` (same folder as docker-compose.yml) and fill in real
# values. `.env` is gitignored and must never be committed - this file is the
# only thing that should be tracked in git.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# SQL Server SA password
# ---------------------------------------------------------------------------
# Used by the `sqlserver` service (SA_PASSWORD) and by the API's connection
# string (ConnectionStrings__SqlServer) to talk to the same instance.
#
# Must satisfy SQL Server's strong password policy or the container will
# refuse to start: at least 8 characters, including at least 3 of the
# following 4 categories - uppercase letters, lowercase letters, digits,
# and symbols.
SQL_SA_PASSWORD=Change-This-P4ssword!

# ---------------------------------------------------------------------------
# JWT signing key
# ---------------------------------------------------------------------------
# Used by the API to sign and validate authentication tokens
# (Jwt__Key -> SymmetricSecurityKey). Must be at least 32 characters
# (256 bits) - shorter values are rejected by the JWT middleware at startup.
#
# For local dev, any random string of 32+ characters is fine. For anything
# beyond local dev, generate a real secret and store it in a proper secret
# store - never commit a real key here or anywhere else in the repo.
JWT_KEY=replace-with-a-random-string-of-at-least-32-characters
